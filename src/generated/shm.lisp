  (let ((%p %pos) response-type nfd sequence length shm-fd)
    (declare (ignorable %p response-type nfd sequence length shm-fd))
    (setf response-type (xcb:read-card8-at %buf %p))
    (setf nfd (xcb:read-card8-at %buf (+ %p 1)))
    (setf sequence (xcb:read-card16-at %buf (+ %p 2) %order))
    (setf length (xcb:read-card32-at %buf (+ %p 4) %order))
    (setf shm-fd (xcb:take-pending-fd))
    (values
     (make-instance 'create-segment-reply :response-type response-type :nfd nfd :sequence sequence
                    :length length :shm-fd shm-fd)
     (+ %pos 32 (* 4 length)))))
(defun create-segment-reply (conn cookie)
  (xcb:read-reply conn cookie #'decode-create-segment-reply))
